rules_version = '2';

// Biblioteca · reglas de Firestore
// Solo pueden entrar las cuentas que tengan un documento en la colección "permitidos"
// cuyo ID sea su UID (lo creas a mano desde la consola de Firebase).
service cloud.firestore {
  match /databases/{database}/documents {

    function permitido() {
      return request.auth != null
        && exists(/databases/$(database)/documents/permitidos/$(request.auth.uid));
    }

    function fichaValida(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.cat is string
        && (!('centro' in d) || d.centro is string)
        && (!('tags' in d) || d.tags is list)
        && (!('filePath' in d) || d.filePath.matches('archivos/.*'))
        // Proveedores: productos que se le compran y archivos por apartado
        && (!('productos' in d) || (d.productos is list && d.productos.size() <= 500))
        && (!('archivos' in d) || (d.archivos is list && d.archivos.size() <= 100))
        && (!('cpProveedor' in d) || (d.cpProveedor is string && d.cpProveedor.size() <= 100))
        // Recetas: tipo de receta y ficha con ingredientes y pasos
        && (!('sub' in d) || (d.sub is string && d.sub.size() <= 40))
        && (!('receta' in d) || (d.receta is map
              && (!('ingredientes' in d.receta) || d.receta.ingredientes is list)
              && (!('pasos' in d.receta) || d.receta.pasos is list)
              && (!('alergenos' in d.receta) || d.receta.alergenos is list)));
    }

    // Lista de cuentas autorizadas: nadie la puede tocar desde la app.
    match /permitidos/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /documentos/{id} {
      allow read: if permitido();
      allow create, update: if permitido() && fichaValida(request.resource.data);
      allow delete: if permitido();
    }

    // Pedidos hechos a proveedores (historial con importe estimado)
    function pedidoValido(d) {
      return d.prov is string && d.prov.size() > 0 && d.prov.size() <= 200
        && d.lineas is list && d.lineas.size() <= 500
        && (!('extra' in d) || (d.extra is list && d.extra.size() <= 200))
        && (!('total' in d) || d.total is number)
        && (!('centro' in d) || d.centro is string);
    }
    match /pedidos/{id} {
      allow read: if permitido();
      allow create, update: if permitido() && pedidoValido(request.resource.data);
      allow delete: if permitido();
    }

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
