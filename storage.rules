rules_version = '2';

// Biblioteca · reglas de Storage
// Misma lista de "permitidos" que Firestore. Solo PDF e imágenes, máximo 100 MB (igual que MAX_MB en index.html).
service firebase.storage {
  match /b/{bucket}/o {

    function permitido() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/permitidos/$(request.auth.uid));
    }

    match /archivos/{nombre} {
      allow read, delete: if permitido();
      allow create: if permitido()
        && request.resource.size <= 100 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf'
            || request.resource.contentType.matches('image/.*'));
      allow update: if false;
    }

    match /{todo=**} {
      allow read, write: if false;
    }
  }
}
